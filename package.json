{
  "name": "agentflow-ai-platform",
  "version": "1.0.0",
  "description": "Agentic AI Operations Automation Platform (Agentflow_AI)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --prefix server\" \"next dev -p 3000\"",
    "server": "npm run dev --prefix server",
    "client": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.4",
    "axios": "^1.8.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  },
  "keywords": [
    "ai",
    "automation",
    "agentic",
    "workflow",
    "langgraph",
    "orchestration",
    "react-flow"
  ],
  "author": "",
  "license": "MIT"
}

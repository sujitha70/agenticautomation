{
  "name": "agentflow-ai-platform",
  "version": "1.0.0",
  "description": "Agentic AI Operations Automation Platform (Agentflow_AI)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "ai",
    "automation",
    "agentic",
    "workflow",
    "langgraph",
    "orchestration",
    "react-flow"
  ],
  "author": "",
  "license": "MIT"
}

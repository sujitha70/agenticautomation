PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/agentflow_ai
USE_IN_MEMORY_DB=true

# Security & Auth
JWT_SECRET=super_secret_jwt_key_agentflow_ai_2026_dev
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis & Queue
REDIS_URL=redis://localhost:6379
USE_IN_MEMORY_QUEUE=true

# AI Providers (Optional - rich deterministic rule generator works if not set)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=

# OAuth Provider Credentials (Optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/gmail/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
